{
  "name": "pr-compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p sample-project/tsconfig.json --noEmit && tsc -p tsconfig.automation.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:automation": "tsc -p tsconfig.automation.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "build:action": "node scripts/build-action.mjs",
    "check:package": "node action-dist/index.mjs --check-package",
    "test:action": "node scripts/build-action.mjs && node --test scripts/action-package.test.mjs scripts/action-pipeline.test.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "npm run build && npm run build:server",
    "start": "node --env-file-if-exists=.env server-dist/index.mjs",
    "test:server": "vitest run tests/server",
    "typecheck:server": "tsc -p tsconfig.automation.json --noEmit",
    "eval:context": "node scripts/evaluate-context.mjs"
  },
  "dependencies": {
    "@octokit/rest": "21.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "0.25.12",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.4"
  }
}
