# Copy to .env locally. Never commit real keys. Node 24+ reads this via npm start.
COMPASS_PUBLIC_URL=http://127.0.0.1:3000
PORT=3000
HOST=127.0.0.1
COMPASS_DATA_DIR=.compass-data

# One GitHub App registration, owned by the Compass service operator.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
# Generate separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable across deploys and back it up separately from the database.
COMPASS_ENCRYPTION_KEY=

# Bob Shell 2.0.5 must be installed on the server when using Bob.
# User model keys are entered through authenticated onboarding, never here.
BOB_PATH=bob
